# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in when you are ready.
# ─────────────────────────────────────────────────────────────

# URL of the JUPRA Spring Boot backend (see the separate jupra-backend project), e.g.
# https://jupra-backend.onrender.com  — no trailing slash.
# When this is set, the Contact form, chatbot AND the founder dashboard at
# /founderofjupra all talk to this backend, and every enquiry is stored in your database.
VITE_API_BASE_URL=

# Optional fallback used ONLY if VITE_API_BASE_URL is left empty: a third-party form
# endpoint (Formspree, Getform, Basin, Web3Forms) for the Contact form / chatbot.
# Works with Formspree, Getform, Basin, Web3Forms or your own API endpoint.
# If both this and VITE_API_BASE_URL are empty, the site falls back to opening the
# visitor's email app (mailto).
VITE_FORM_ENDPOINT=
